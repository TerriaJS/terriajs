{
  "name": "terria-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "TerriaJS monorepo: terriajs, terriajs-server, and TerriaMap.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run build && pnpm --filter terriajs-map start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "sync-readme": "node -e \"require('node:fs').copyFileSync('packages/terriajs/README.md','README.md')\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "0.72.0",
    "turbo": "2.9.16"
  }
}
