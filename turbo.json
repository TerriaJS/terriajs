{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "ts-out/**", "wwwroot/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build-for-node": {
      "dependsOn": ["^build-for-node"],
      "outputs": ["build/**", "ts-out/**"]
    },
    "build-specs": {
      "dependsOn": ["^build"],
      "outputs": ["wwwroot/build/**"]
    },
    "test": {
      "dependsOn": ["build-specs"],
      "cache": false
    },
    "lint": {}
  }
}
