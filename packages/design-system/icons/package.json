{
  "name": "@terria/design-system-icons",
  "version": "0.0.0",
  "devDependencies": {
    "@types/react": "catalog:types",
    "@typescript/native": "catalog:build",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:test",
    "playwright": "catalog:runtime",
    "react": "catalog:runtime",
    "rollup": "catalog:runtime",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "catalog:runtime",
    "svgo": "4.1.0",
    "typescript": "catalog:build",
    "vite": "catalog:runtime",
    "vitest": "^5.0.5",
    "@types/node": "catalog:types",
    "@eslint-react/eslint-plugin": "catalog:build",
    "@eslint/js": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-import-resolver-typescript": "catalog:lint",
    "eslint-plugin-import": "catalog:lint",
    "eslint-plugin-jsx-a11y": "catalog:lint",
    "eslint-plugin-react": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "typescript-eslint": "catalog:lint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "rollup -c --watch",
    "fetch-icons": "node --env-file-if-exists=../../../.env scripts/fetch-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint ."
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
