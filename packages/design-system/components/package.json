{
  "name": "@terria/design-system",
  "version": "0.0.0",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@react-aria/live-announcer": "3.5.1",
    "@react-aria/utils": "3.34.1",
    "@terria/design-system-icons": "workspace:*",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@types/pngjs": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@typescript/native": "catalog:build",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:test",
    "autoprefixer": "catalog:runtime",
    "glob": "^13.0.6",
    "playwright": "catalog:runtime",
    "pngjs": "7.0.0",
    "postcss": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "rollup": "catalog:runtime",
    "rollup-plugin-esbuild": "catalog:runtime",
    "storybook": "catalog:storybook",
    "typescript": "catalog:build",
    "vite": "catalog:runtime",
    "vitest": "^5.0.5",
    "vitest-browser-react": "catalog:runtime",
    "@types/node": "catalog:types",
    "@eslint-react/eslint-plugin": "catalog:build",
    "@eslint/css": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-import-resolver-typescript": "catalog:lint",
    "eslint-plugin-import": "catalog:lint",
    "eslint-plugin-jsx-a11y": "catalog:lint",
    "eslint-plugin-react": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "eslint-plugin-storybook": "catalog:lint",
    "stylelint": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-declaration-strict-value": "catalog:lint",
    "stylelint-value-no-unknown-custom-properties": "catalog:lint",
    "typescript-eslint": "catalog:lint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./layers.css": "./dist/layers.css",
    "./reset.css": "./dist/reset.css",
    "./typography.css": "./dist/typography.css",
    "./layout.css": "./dist/layout/index.css",
    "./fonts.css": "./dist/fonts.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "private": true,
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "rollup -c",
    "build:types": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "pnpm run dev:js & pnpm run dev:types",
    "dev:js": "rollup -c --watch",
    "dev:types": "tsc --build tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run -c vitest.visual.config.ts",
    "typecheck": "tsc",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "./dist/index.d.ts"
}
