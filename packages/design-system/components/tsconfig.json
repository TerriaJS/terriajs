{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Never emits; tools like knip map the dist exports back to src through these
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
