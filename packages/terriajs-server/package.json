{
  "name": "terriajs-server",
  "version": "5.0.0",
  "description": "NodeJS server for TerriaJS, consisting of a CORS proxy, proj4 CRS lookup service, and express static server.",
  "engineStrict": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "exports": {
    "./terriajs-server.js": "./terriajs-server.js",
    ".": {
      "default": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "test": "jasmine",
    "lint": "eslint .",
    "watch": "node --watch-path serverconfig.json --watch lib/app.js ",
    "start": "node lib/app.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "bin": {
    "terriajs-server": "terriajs-server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerriaJS/TerriaJS-Server"
  },
  "keywords": [
    "terriajs",
    "National Map"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/TerriaJS/TerriaJS-Server/issues"
  },
  "homepage": "https://github.com/TerriaJS/TerriaJS-Server",
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:runtime",
    "base-x": "^5.0.1",
    "basic-auth": "^2.0.1",
    "body-parser": "^2.3.0",
    "bytes": "^3.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "catalog:runtime",
    "helmet": "^8.2.0",
    "json5": "catalog:runtime",
    "morgan": "^1.11.0",
    "proj4-cli-defs": "^2.1.0",
    "range_check": "^4.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "safe-regex2": "^5.1.1",
    "undici": "^8.7.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@eslint/json": "catalog:lint",
    "@testcontainers/localstack": "^12.0.4",
    "@types/express": "catalog:types",
    "@types/node": "^26.1.1",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-n": "catalog:lint",
    "globals": "catalog:lint",
    "http-proxy": "^1.18.1",
    "jasmine": "^6.3.0",
    "msw": "catalog:test",
    "oxfmt": "catalog:lint",
    "supertest": "^7.2.2",
    "testcontainers": "catalog:test"
  }
}
