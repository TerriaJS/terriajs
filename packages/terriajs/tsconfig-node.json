// This tsconfig is used to build the model layer only for use in a node.js app.
// Build with ./node_modules/.bin/tsc -p tsconfig-node.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["terriajs-cesium"]
  },
  "include": ["./lib/**/*"],
  // The new UI runs in the browser only, built by an app's webpack once the
  // design system is built, so it isn't part of the node build
  "exclude": ["./lib/UI/**"]
}
