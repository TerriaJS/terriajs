{
  "trailingComma": "none",
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/build/",
    "**/ts-out/",
    "**/coverage/",
    "**/.turbo/",
    "**/.history/",
    ".idea/",
    ".DS_Store",
    "*.swp",
    "*.log",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "**/*.scss.d.ts",
    "**/catalog-index*.json",
    "packages/terriajs/terria.lib.js",
    "packages/terriajs/terriajs.pid",
    "packages/terriajs/terriajs-server.log",
    "packages/terriajs/wwwroot/doc/",
    "packages/terriajs/wwwroot/schema/",
    "packages/terriajs/wwwroot/user-guide/",
    "packages/terriajs/wwwroot/data/regionids",
    "packages/terriajs/lib/ThirdParty/i18n/resources.d.ts",
    "packages/terriajs/wwwroot/third_party/",
    "packages/terriajs/wwwroot/mockServiceWorker.js",
    "packages/terriajs/doc/acknowledgements/attributions.md",
    "packages/terriajs/project.inlang/cache/"
  ]
}
