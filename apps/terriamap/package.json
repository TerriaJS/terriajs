{
  "private": true,
  "name": "terriajs-map",
  "version": "0.4.8",
  "description": "Geospatial catalog explorer based on TerriaJS.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/TerriaJS/TerriaMap"
  },
  "dependencies": {
    "terriajs-server": "workspace:*"
  },
  "resolutions": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "catalog:build",
    "@babel/preset-env": "catalog:build",
    "@babel/preset-react": "catalog:build",
    "@eslint/js": "catalog:lint",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@typescript-eslint/eslint-plugin": "catalog:lint",
    "@typescript-eslint/parser": "catalog:lint",
    "babel-loader": "catalog:build",
    "css-loader": "catalog:build",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-react": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "fetch-mock": "catalog:test",
    "fork-ts-checker-notifier-webpack-plugin": "catalog:build",
    "fork-ts-checker-webpack-plugin": "catalog:build",
    "fs-extra": "catalog:build",
    "globals": "catalog:lint",
    "gulp": "catalog:build",
    "html-webpack-plugin": "catalog:build",
    "husky": "catalog:lint",
    "json5": "catalog:runtime",
    "lodash": "catalog:runtime",
    "minimist": "catalog:build",
    "mobx": "catalog:runtime",
    "mobx-react": "catalog:runtime",
    "msw": "catalog:test",
    "node-notifier": "catalog:build",
    "oxfmt": "catalog:lint",
    "plugin-error": "catalog:build",
    "prop-types": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "resolve-url-loader": "catalog:build",
    "sass": "catalog:build",
    "sass-loader": "catalog:build",
    "style-loader": "catalog:build",
    "svg-sprite": "catalog:build",
    "terriajs": "workspace:*",
    "terriajs-cesium": "catalog:terria",
    "terriajs-plugin-api": "catalog:terria",
    "terriajs-plugin-sample": "catalog:terria",
    "terriajs-typings-for-css-modules-loader": "catalog:build",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "urijs": "catalog:runtime",
    "webpack": "catalog:build",
    "webpack-cli": "catalog:build",
    "yargs": "catalog:build"
  },
  "scripts": {
    "start": "terriajs-server --config-file serverconfig.json",
    "gulp": "gulp",
    "build": "gulp build",
    "dev": "gulp dev",
    "postinstall": "echo 'Installation successful. What to do next:\\n  pnpm gulp dev   # Starts the server on port 3001, builds TerriaMap and dependencies, and rebuilds if files change.'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "gulp lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
